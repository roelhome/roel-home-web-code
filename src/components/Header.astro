---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="site-header">
  <div class="container nav-shell">
    <a class="brand-link" href="/" aria-label="ROEL Home Solutions — home">
      <img src="/images/roel-logo-clean.png" alt="Roel Home Solutions" />
    </a>
    <nav class="nav-list" id="main-nav" aria-label="Main navigation">
      <a href="/" data-nav="home" class={currentPath === '/' ? 'active' : ''}>Home</a>
      <a href="/catalogue" data-nav="catalogue" class={currentPath.startsWith('/catalogue') || currentPath.startsWith('/product') ? 'active' : ''}>Products</a>
      <a href="/services" data-nav="services" class={currentPath.startsWith('/services') || currentPath.startsWith('/service') ? 'active' : ''}>Services</a>
      <a href="/projects" data-nav="projects" class={currentPath.startsWith('/projects') || currentPath.startsWith('/project') ? 'active' : ''}>Projects</a>
      <a href="/about" data-nav="about" class={currentPath === '/about' ? 'active' : ''}>Our Story</a>
      <a href="/contact" data-nav="contact" class={currentPath === '/contact' ? 'active' : ''}>Contact</a>
    </nav>
    <div class="nav-actions">
      <button type="button" class="icon-button" id="search-trigger" aria-label="Search the website">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          <circle cx="10.8" cy="10.8" r="6.8"></circle>
          <path d="m16 16 5 5"></path>
        </svg>
      </button>
      <button type="button" class="btn header-cta small" data-enquiry="General project enquiry">
        Enquire Now <span class="arrow">↗</span>
      </button>
      <button type="button" class="icon-button menu-button" id="menu-trigger" aria-label="Toggle navigation" aria-expanded="false">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M3 7h18M3 12h18M3 17h18"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const menuTrigger = document.getElementById('menu-trigger');
  const mainNav = document.getElementById('main-nav');

  menuTrigger?.addEventListener('click', () => {
    const isOpen = mainNav?.classList.toggle('open');
    menuTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  // Close mobile nav when clicking a link
  mainNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mainNav.classList.remove('open');
      menuTrigger?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
