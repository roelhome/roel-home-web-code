---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getProjects } from '../../lib/supabase';

const projects = await getProjects();
---

<Layout 
  title="Visual Journal & Projects | ROEL Home Solutions Kochi"
  description="Explore spaces elevated by ROEL: residential villas in Aluva, commercial studios in Kakkanad, and modern facades in Edappally, Kochi."
>
  <!-- Page Header -->
  <section class="section" style="padding-bottom:48px;">
    <div class="container">
      <div style="border-bottom:1px solid var(--line);padding-bottom:48px;">
        <span class="eyebrow" style="color:var(--walnut);margin-bottom:16px;">A Visual Journal</span>
        <h1 style="font:400 clamp(48px, 6vw, 92px)/0.95 'RoelSerif', serif;margin-bottom:20px;">
          Material in <em>context.</em>
        </h1>
        <p style="font-size:18px;color:var(--muted);max-width:640px;line-height:1.6;">
          Explore the character of spaces shaped by warm architectural surfaces, thoughtful proportions and contemporary details across Kerala.
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <div class="projects-grid gsap-stagger-parent">
        {projects.map((pj) => (
          <a class="project-card gsap-stagger-child" href={`/project/${pj.id}`}>
            <div class="project-photo">
              <img src={pj.image} alt={`${pj.name} architectural showcase`} loading="lazy" />
              <span class="project-pill">{pj.isDemo ? 'Sample concept' : 'Portfolio entry'}</span>
              <div class="project-overlay">
                <span>{pj.category}</span>
                <h3>{pj.name}</h3>
              </div>
            </div>
            <div class="project-location">
              <span>{pj.location} &nbsp;/&nbsp; {pj.year}</span>
              <span>↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <CtaBand 
    eyebrow="Have a project in mind?"
    title="Let's discuss materials for your"
    italicWord="upcoming build."
    description="Send us your floor plans, elevations, or 3D renders. We will help map the ideal surfaces, doors, and partitions for each space."
    buttonText="Share Project Details"
    enquiryContext="Project portfolio consultation"
  />
</Layout>
