---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getProjects } from '../../lib/supabase';
import { imgSrc } from '../../data/originalData.js';

const projects = await getProjects();
---

<Layout 
  title="Projects Gallery | ROEL Home Solutions"
  description="Material in context. Explore the character of spaces shaped by warm materials, thoughtful proportions and contemporary details."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">A visual journal</span>
      <h1>Material in <em>context.</em></h1>
      <p>Explore the character of spaces shaped by warm materials, thoughtful proportions and contemporary details.</p>
      <div class="page-count">{String(projects.length).padStart(2, '0')}</div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="project-grid">
        {projects.map((p) => (
          <a class="project-card" href={`/project/${p.id}`}>
            <div class="project-photo">
              <img src={imgSrc(p.image)} alt={`${p.name} architectural showcase`} loading="lazy" />
              <span class="project-pill">{p.category}</span>
              <div class="project-overlay">
                <span>{p.category}</span>
                <h3>{p.name}</h3>
              </div>
            </div>
            <div class="project-location">
              <span>{p.location} &nbsp;/&nbsp; {p.year}</span>
              <span>↗</span>
            </div>
          </a>
        ))}
      </div>
      <div style="margin-top:38px">
        <button type="button" class="text-link" style="background:none;border-top:none;border-left:none;border-right:none;cursor:pointer" data-enquiry="New custom architectural project enquiry">
          Enquire about a custom project <span class="arrow">↗</span>
        </button>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-row">
      <div>
        <span class="eyebrow">The next chapter starts here</span>
        <h2>Let's shape your<br /><em class="italic">next space.</em></h2>
      </div>
      <div>
        <p>Tell us what you are creating. We will help you explore the material direction for your home or project.</p>
        <button class="btn" type="button" data-enquiry="Consultation for a new space">Start a conversation <span class="arrow">↗</span></button>
      </div>
    </div>
  </section>
</Layout>
