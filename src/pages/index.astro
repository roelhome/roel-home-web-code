---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getFeaturedProducts, getServices, getProjects, getHeroSlides, getHomeVideo } from '../lib/supabase';
import { imgSrc } from '../data/originalData.js';

const products = await getFeaturedProducts();
const services = await getServices();
const projects = await getProjects();
const heroSlides = await getHeroSlides();
const homeVideo = await getHomeVideo();
---

<Layout 
  title="ROEL Home Solutions | Spaces Elevated | Architectural Materials Kochi"
  description="ROEL Home Solutions — architectural materials, distinctive doors, wall solutions and decorative accents in Kochi, Kerala. Creating spaces, defining living."
>
  <!-- Unified Landscape Hero Slider Section -->
  <section class="hero hero-landscape" id="hero-slider" aria-label="Architectural Collections Slider">
    <!-- Slide Backgrounds -->
    <div class="hero-bg-stack">
      {heroSlides.map((slide, i) => (
        <div class={`hero-slide-bg ${i === 0 ? 'active' : ''}`} data-bg-index={i}>
          <picture>
            <source media="(max-width: 768px)" srcset={slide.imageMobile} />
            <img 
              src={slide.image} 
              alt={slide.alt}
              width="1920"
              height="1080"
              fetchpriority={i === 0 ? "high" : "low"}
              loading={i === 0 ? "eager" : "lazy"}
            />
          </picture>
        </div>
      ))}
      <div class="hero-overlay" aria-hidden="true"></div>
    </div>

    <div class="container hero-container">
      <!-- Slide Content Panes -->
      <div class="hero-content-stack gsap-fade-up">
        {heroSlides.map((slide, i) => (
          <div class={`hero-slide-content ${i === 0 ? 'active' : ''}`} data-content-index={i}>
            <div class="hero-eyebrow">
              {(slide.eyebrow || []).map((item, idx) => (
                <>
                  <span class={item.active ? 'active-pillar' : ''}>{item.text}</span>
                  {idx < (slide.eyebrow || []).length - 1 && <span class="sep">|</span>}
                </>
              ))}
            </div>
            <h1 class="hero-title" set:html={slide.title} />
            <p class="hero-desc">{slide.desc}</p>
            <div class="hero-cta-wrap">
              <a class="btn hero-btn" href={slide.ctaLink}>
                <span>{slide.ctaText}</span>
                <span class="arrow">&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Footer Bar: Pagination & Arrows & Brand Signature -->
      <div class="hero-footer-bar">
        <div class="hero-pagination" aria-label="Hero slider pagination">
          {heroSlides.map((_, i) => (
            <button 
              type="button" 
              class={`page-num ${i === 0 ? 'active' : ''}`} 
              data-slide={i} 
              aria-label={`Slide ${String(i + 1).padStart(2, '0')}`}
            >
              <span>{String(i + 1).padStart(2, '0')}</span>
              <span class="page-line"></span>
            </button>
          ))}
        </div>

        <div class="hero-footer-right">
          <div class="hero-visual-label">
            <span class="hero-tagline">DESIGNED FOR THE WAY WE LIVE</span>
            <span class="hero-number">R.</span>
          </div>
          <div class="hero-arrows">
            <button type="button" class="hero-arrow-btn prev-arrow" aria-label="Previous slide">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
            </button>
            <button type="button" class="hero-arrow-btn next-arrow" aria-label="Next slide">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const slider = document.getElementById('hero-slider');
    const bgSlides = document.querySelectorAll<HTMLElement>('.hero-slide-bg');
    const contentSlides = document.querySelectorAll<HTMLElement>('.hero-slide-content');
    const pageItems = document.querySelectorAll<HTMLButtonElement>('.hero-pagination .page-num');
    const prevBtn = document.querySelector<HTMLButtonElement>('.hero-arrow-btn.prev-arrow');
    const nextBtn = document.querySelector<HTMLButtonElement>('.hero-arrow-btn.next-arrow');

    let activeIdx = 0;
    const totalSlides = bgSlides.length;
    let autoPlayTimer: any = null;
    let isAnimating = false;
    const DURATION = 800; // ms
    const EASING = 'cubic-bezier(0.22, 1, 0.36, 1)'; // Luxury smooth deceleration

    function goToSlide(targetIdx: number, explicitDirection?: 'next' | 'prev') {
      if (!totalSlides || targetIdx === activeIdx || isAnimating) return;
      isAnimating = true;

      // Determine movement direction: 'next' (slide right-to-left) or 'prev' (slide left-to-right)
      let dir = explicitDirection;
      if (!dir) {
        if (activeIdx === totalSlides - 1 && targetIdx === 0) {
          dir = 'next';
        } else if (activeIdx === 0 && targetIdx === totalSlides - 1) {
          dir = 'prev';
        } else {
          dir = targetIdx > activeIdx ? 'next' : 'prev';
        }
      }

      const currentBg = bgSlides[activeIdx];
      const targetBg = bgSlides[targetIdx];
      const currentContent = contentSlides[activeIdx];
      const targetContent = contentSlides[targetIdx];

      // Reset any pending transitions & set initial incoming positions
      targetBg.style.transition = 'none';
      targetContent.style.transition = 'none';

      if (dir === 'next') {
        targetBg.style.transform = 'translate3d(100%, 0, 0)';
        targetContent.style.transform = 'translate3d(70px, 0, 0)';
      } else {
        targetBg.style.transform = 'translate3d(-100%, 0, 0)';
        targetContent.style.transform = 'translate3d(-70px, 0, 0)';
      }
      targetContent.style.opacity = '0';
      targetBg.classList.add('animating');
      targetContent.classList.add('animating');

      // Force synchronous reflow so browser registers initial position
      void targetBg.offsetWidth;
      void targetContent.offsetWidth;

      // Set smooth transition curve
      currentBg.style.transition = `transform ${DURATION}ms ${EASING}`;
      targetBg.style.transition = `transform ${DURATION}ms ${EASING}`;

      currentContent.style.transition = `transform ${DURATION * 0.9}ms ${EASING}, opacity ${DURATION * 0.65}ms ease`;
      targetContent.style.transition = `transform ${DURATION * 0.9}ms ${EASING}, opacity ${DURATION * 0.65}ms ease`;

      // Animate current slide out
      if (dir === 'next') {
        currentBg.style.transform = 'translate3d(-100%, 0, 0)';
        currentContent.style.transform = 'translate3d(-70px, 0, 0)';
      } else {
        currentBg.style.transform = 'translate3d(100%, 0, 0)';
        currentContent.style.transform = 'translate3d(70px, 0, 0)';
      }
      currentContent.style.opacity = '0';

      // Animate target slide in
      targetBg.style.transform = 'translate3d(0, 0, 0)';
      targetContent.style.transform = 'translate3d(0, 0, 0)';
      targetContent.style.opacity = '1';

      // Update pagination indicators immediately
      pageItems.forEach((btn, i) => {
        btn.classList.toggle('active', i === targetIdx);
      });

      // Once animation completes, clean up classes and inline styles
      setTimeout(() => {
        bgSlides.forEach((slide, i) => {
          slide.style.transition = '';
          slide.classList.remove('animating');
          if (i === targetIdx) {
            slide.classList.add('active');
            slide.style.transform = 'translate3d(0, 0, 0)';
          } else {
            slide.classList.remove('active');
            slide.style.transform = 'translate3d(100%, 0, 0)';
          }
        });

        contentSlides.forEach((content, i) => {
          content.style.transition = '';
          content.classList.remove('animating');
          if (i === targetIdx) {
            content.classList.add('active');
            content.style.transform = 'translate3d(0, 0, 0)';
            content.style.opacity = '1';
          } else {
            content.classList.remove('active');
            content.style.transform = 'translate3d(70px, 0, 0)';
            content.style.opacity = '0';
          }
        });

        activeIdx = targetIdx;
        isAnimating = false;
      }, DURATION + 20);
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        goToSlide((activeIdx + 1) % totalSlides, 'next');
      }, 7000);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    pageItems.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        goToSlide(i);
        startAutoPlay();
      });
    });

    prevBtn?.addEventListener('click', () => {
      goToSlide((activeIdx - 1 + totalSlides) % totalSlides, 'prev');
      startAutoPlay();
    });

    nextBtn?.addEventListener('click', () => {
      goToSlide((activeIdx + 1) % totalSlides, 'next');
      startAutoPlay();
    });

    // Touch swipe handling for mobile
    let touchStartX = 0;
    let touchEndX = 0;

    slider?.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoPlay();
    }, { passive: true });

    slider?.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          goToSlide((activeIdx + 1) % totalSlides, 'next');
        } else {
          goToSlide((activeIdx - 1 + totalSlides) % totalSlides, 'prev');
        }
      }
      startAutoPlay();
    }, { passive: true });

    slider?.addEventListener('mouseenter', stopAutoPlay);
    slider?.addEventListener('mouseleave', startAutoPlay);

    // Pause autoplay when window is hidden
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoPlay();
      } else {
        startAutoPlay();
      }
    });

    // Initial run
    startAutoPlay();

    // Inline Brand Film playback controller (supports both HTML5 <video> and YouTube embeds)
    const filmFrame = document.getElementById('inline-film-container');
    const filmVideo = document.getElementById('inline-film-video') as HTMLVideoElement | null;
    const filmPlayBtn = document.getElementById('inline-film-play-btn');
    const watchTextBtn = document.getElementById('play-inline-film-btn');
    const videoType = filmFrame?.getAttribute('data-video-type') || 'upload';
    const youtubeId = filmFrame?.getAttribute('data-youtube-id') || '';

    function playInlineFilm() {
      if (!filmFrame) return;

      if (videoType === 'youtube' && youtubeId) {
        const playerSlot = document.getElementById('youtube-player-container');
        if (playerSlot && !playerSlot.querySelector('iframe')) {
          const iframe = document.createElement('iframe');
          iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?autoplay=1&rel=0&modestbranding=1&enablejsapi=1`;
          iframe.title = 'ROEL Visual Study Film';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
          iframe.allowFullscreen = true;
          iframe.style.width = '100%';
          iframe.style.height = '100%';
          iframe.style.border = '0';
          iframe.style.display = 'block';

          playerSlot.innerHTML = '';
          playerSlot.appendChild(iframe);
        }
        filmFrame.classList.add('is-playing');
        return;
      }

      if (!filmVideo) return;

      if (filmVideo.paused) {
        filmVideo.controls = true;
        const playPromise = filmVideo.play();
        if (playPromise !== undefined) {
          playPromise
            .then(() => {
              filmFrame.classList.add('is-playing');
            })
            .catch(() => {
              // Browser policy fallback: try muted playback if unmuted was blocked
              filmVideo.muted = true;
              filmVideo.play().then(() => {
                filmFrame.classList.add('is-playing');
              }).catch(() => {});
            });
        }
      } else {
        filmVideo.pause();
      }
    }

    filmPlayBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      playInlineFilm();
    });

    filmFrame?.addEventListener('click', () => {
      // If clicking on the frame when not actively playing with native controls
      if (filmFrame && !filmFrame.classList.contains('is-playing')) {
        playInlineFilm();
      }
    });

    watchTextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      filmFrame?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      playInlineFilm();
    });

    filmPlayBtn?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        playInlineFilm();
      }
    });

    filmFrame?.addEventListener('keydown', (e) => {
      if ((e.key === 'Enter' || e.key === ' ') && !filmFrame.classList.contains('is-playing')) {
        e.preventDefault();
        playInlineFilm();
      }
    });

    filmVideo?.addEventListener('play', () => {
      filmFrame?.classList.add('is-playing');
      if (filmVideo) filmVideo.controls = true;
    });

    filmVideo?.addEventListener('ended', () => {
      if (filmFrame && filmVideo) {
        filmFrame.classList.remove('is-playing');
        filmVideo.controls = false;
        filmVideo.currentTime = 0;
      }
    });

    // Mobile Selected Products Carousel Controller
    const prodTrack = document.getElementById('home-products-track');
    const prodSteps = document.querySelectorAll<HTMLButtonElement>('#home-products-pagination .carousel-step');
    const prodPrev = document.getElementById('home-prod-prev') as HTMLButtonElement | null;
    const prodNext = document.getElementById('home-prod-next') as HTMLButtonElement | null;

    if (prodTrack && prodSteps.length > 0) {
      const getActiveProductIndex = () => {
        const cards = prodTrack.querySelectorAll<HTMLElement>('.product-card');
        if (!cards.length) return 0;
        const scrollLeft = prodTrack.scrollLeft;
        let closestIdx = 0;
        let minDiff = Infinity;
        cards.forEach((card, idx) => {
          const cardLeft = card.offsetLeft - prodTrack.offsetLeft;
          const diff = Math.abs(cardLeft - scrollLeft);
          if (diff < minDiff) {
            minDiff = diff;
            closestIdx = idx;
          }
        });
        return closestIdx;
      };

      const syncPagination = () => {
        const activeIdx = getActiveProductIndex();
        const cards = prodTrack.querySelectorAll<HTMLElement>('.product-card');
        prodSteps.forEach((step, idx) => {
          step.classList.toggle('active', idx === activeIdx);
        });
        if (prodPrev) prodPrev.disabled = activeIdx === 0;
        if (prodNext) prodNext.disabled = activeIdx >= cards.length - 1;
      };

      let scrollTimeout: any = null;
      prodTrack.addEventListener('scroll', () => {
        if (!scrollTimeout) {
          scrollTimeout = requestAnimationFrame(() => {
            syncPagination();
            scrollTimeout = null;
          });
        }
      }, { passive: true });

      const scrollToProduct = (targetIdx: number) => {
        const cards = prodTrack.querySelectorAll<HTMLElement>('.product-card');
        if (targetIdx === 0) {
          prodTrack.scrollTo({ left: 0, behavior: 'smooth' });
        } else if (cards[targetIdx]) {
          cards[targetIdx].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        }
      };

      prodSteps.forEach((step, idx) => {
        step.addEventListener('click', () => {
          scrollToProduct(idx);
        });
      });

      prodPrev?.addEventListener('click', () => {
        const currentIdx = getActiveProductIndex();
        if (currentIdx > 0) {
          scrollToProduct(currentIdx - 1);
        }
      });

      prodNext?.addEventListener('click', () => {
        const currentIdx = getActiveProductIndex();
        const cards = prodTrack.querySelectorAll<HTMLElement>('.product-card');
        if (currentIdx < cards.length - 1) {
          scrollToProduct(currentIdx + 1);
        }
      });

      // Synchronize initial state
      syncPagination();
    }
  </script>

  <!-- Hero Bottom Features -->
  <div class="hero-bottom">
    <div class="container">
      <div class="hero-feature"><b>01</b><span>Architectural<br />wall solutions</span></div>
      <div class="hero-feature"><b>02</b><span>Distinctive<br />door products</span></div>
      <div class="hero-feature"><b>03</b><span>Decorative<br />design accents</span></div>
    </div>
  </div>

  <!-- Philosophy / Intro -->
  <section class="section">
    <div class="container intro-block gsap-fade-up">
      <div class="intro-overline">
        <span class="eyebrow">The ROEL philosophy</span>
        <strong>R.</strong>
        <span class="micro">A considered approach<br />to better spaces</span>
      </div>
      <div>
        <h2 class="intro-statement serif">We believe the difference is in <em>the details.</em></h2>
        <p>Exceptional spaces begin with the right materials. At ROEL, we bring together contemporary aesthetics, quality-driven selections and thoughtful guidance to make each decision count.</p>
        <a class="text-link" href="/about">Get to know ROEL <span class="arrow">↗</span></a>
      </div>
    </div>
  </section>

  <!-- Selected Products -->
  <section class="section selected-products-section" style="padding-top:25px">
    <div class="container">
      <div class="section-head gsap-fade-up">
        <div>
          <span class="eyebrow">01 / Selected products</span>
          <h2>Made to make <em class="italic">an impression.</em></h2>
        </div>
        <div>
          <a class="text-link" href="/catalogue">Catalogue <span class="arrow">↗</span></a>
        </div>
      </div>
      <div class="home-products-wrapper">
        <div class="product-grid home-selected-grid gsap-stagger-parent" id="home-products-track">
          {products.map((p, idx) => {
            const waMessage = `Hello ROEL Home Solutions, I would like to enquire about ${p.name} (${p.sku}). Please share details and a quotation.`;
            const waLink = `https://wa.me/918111899991?text=${encodeURIComponent(waMessage)}`;

            return (
              <article
                class="product-card gsap-stagger-child"
                data-prod-index={idx}
              >
                <a class="product-image" href={`/product/${p.id}`} aria-label={`View ${p.name}`}>
                  <img src={imgSrc(p.image)} alt={`${p.name} architectural detail`} loading="lazy" />
                  <span class="on-image-tag">
                    {p.category}
                    {p.variants && p.variants.length > 1 ? ` • ${p.variants.length} Options` : ''}
                  </span>
                </a>
                <div class="product-info">
                  <div>
                    <div class="micro muted">{p.sku}</div>
                    <h3><a href={`/product/${p.id}`}>{p.name}</a></h3>
                    {p.short && <p>{p.short}</p>}
                  </div>
                  <div class="product-price">
                    <small>{p.variants && p.variants.length > 1 ? `${p.variants.length} Options from` : 'Starting from'}</small>
                    <span>{p.price}</span>
                  </div>
                </div>
                <div class="product-actions">
                  <a
                    href={`/product/${p.id}`}
                    class="product-btn-view"
                    aria-label={`View details of ${p.name}`}
                  >
                    <span>View Details</span>
                    <span class="product-btn-arrow" aria-hidden="true">→</span>
                  </a>
                  <span class="product-actions-divider" aria-hidden="true" />
                  <a
                    href={waLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="product-btn-enquire"
                    aria-label={`Enquire about ${p.name} on WhatsApp`}
                  >
                    <svg
                      viewBox="0 0 16 16"
                      class="product-wa-icon"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.929.809 2.062c.099.134 1.39 2.123 3.37 2.978.472.203.84.324 1.127.416.474.152.905.13 1.246.08.38-.058 1.17-.479 1.338-.942.166-.464.166-.86.116-.942-.049-.082-.181-.133-.379-.232"
                      />
                    </svg>
                    <span>Enquire</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Mobile Carousel Navigation Bar (Hidden on Desktop & Tablet) -->
        <div class="home-products-mobile-bar" aria-label="Selected products navigation">
          <div class="mobile-carousel-pagination" id="home-products-pagination">
            {products.slice(0, 5).map((_, i) => (
              <>
                <button type="button" class={`carousel-step ${i === 0 ? 'active' : ''}`} data-step={i} aria-label={`View product ${i + 1}`}>
                  {String(i + 1).padStart(2, '0')}
                </button>
                {i < Math.min(products.length, 5) - 1 && <span class="carousel-dash" aria-hidden="true"></span>}
              </>
            ))}
          </div>
          <div class="mobile-carousel-controls">
            <button type="button" class="carousel-arrow-btn prev" id="home-prod-prev" aria-label="Previous product" disabled>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" class="carousel-arrow-btn next" id="home-prod-next" aria-label="Next product">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Manifesto Section -->
  <section class="manifesto">
    <div class="manifesto-image">
      <img src="/images/wave.webp" alt="Sculptural wood architectural ceiling detail" loading="lazy" />
    </div>
    <div class="manifesto-copy gsap-fade-up">
      <span class="eyebrow">The ROEL perspective</span>
      <h2>Materials<br />with <em class="italic">meaning.</em></h2>
      <p>Texture. Proportion. Light. The most memorable interiors are built through deliberate material choices, not excess. We help connect the vision to the detail.</p>
      <div><a class="text-link light" href="/services">See our approach <span class="arrow">↗</span></a></div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="section">
    <div class="container">
      <div class="section-head gsap-fade-up">
        <div>
          <span class="eyebrow">02 / What we do</span>
          <h2>More than <em class="italic">materials.</em></h2>
        </div>
        <p>Support at each stage, from exploring a material direction to planning the right finishes for the space.</p>
      </div>
      <div class="service-list gsap-stagger-parent">
        {services.map((s) => (
          <a class="service-row gsap-stagger-child" href={`/service/${s.id}`}>
            <span class="service-index">{s.number}</span>
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
            <span class="round-arrow">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Spaces in Focus / Projects -->
  <section class="section projects-section">
    <div class="container">
      <div class="section-head gsap-fade-up">
        <div>
          <span class="eyebrow">03 / Spaces in focus</span>
          <h2>Ideas made <em class="italic">visible.</em></h2>
        </div>
        <a class="text-link" href="/projects">Explore the gallery <span class="arrow">↗</span></a>
      </div>
      <div class="project-grid gsap-stagger-parent">
        {projects.slice(0, 3).map((p) => (
          <a class="project-card gsap-stagger-child" href={`/project/${p.id}`}>
            <div class="project-photo">
              <img src={imgSrc(p.image)} alt={`${p.name} architectural showcase`} loading="lazy" />
              <span class="project-pill">{p.category}</span>
              <div class="project-overlay">
                <span>{p.category}</span>
                <h3>{p.name}</h3>
              </div>
            </div>
            <div class="project-location">
              <span>{p.location} &nbsp;/&nbsp; {p.year}</span>
              <span>↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand Film Section -->
  <section class="film-section">
    <div class="container film-layout">
      <div class="film-copy gsap-fade-up">
        <span class="eyebrow" style="color:var(--champagne)">{homeVideo.subtitle || "04 / Our design language"}</span>
        {homeVideo.title && homeVideo.title !== 'A closer look.' ? (
          <h2><Fragment set:html={homeVideo.title} /></h2>
        ) : (
          <h2>A closer<br /><em class="italic">look.</em></h2>
        )}
        <p>A short visual study of surfaces, light and detail. Explore the atmosphere behind the ROEL approach.</p>
        <button type="button" class="text-link light" style="background:none;border-left:0;border-right:0;border-top:0;cursor:pointer" id="play-inline-film-btn" aria-label="Watch the visual study video">
          Watch the visual study <span class="arrow">↗</span>
        </button>
      </div>
      <div 
        class="film-frame" 
        id="inline-film-container" 
        tabindex="0" 
        role="region" 
        aria-label="ROEL visual concept film"
        data-video-type={homeVideo.source_type}
        data-youtube-id={homeVideo.youtube_id || ""}
      >
        {homeVideo.source_type === 'youtube' && homeVideo.youtube_id ? (
          <>
            <img 
              id="inline-film-poster"
              class="film-video film-poster" 
              src={homeVideo.poster_url || `https://img.youtube.com/vi/${homeVideo.youtube_id}/maxresdefault.jpg`} 
              alt="ROEL visual concept preview"
              loading="lazy"
            />
            <div id="youtube-player-container" class="youtube-player-slot"></div>
          </>
        ) : (
          <video 
            id="inline-film-video"
            class="film-video"
            src={homeVideo.url || "/videos/video.mp4"} 
            poster={homeVideo.poster_url || "/images/hero.webp"}
            playsinline
            webkit-playsinline
            preload="metadata"
            aria-label="ROEL architectural visual concept preview"
          ></video>
        )}
        <div class="film-play" id="inline-film-play-btn" role="button" tabindex="0" aria-label="Play ROEL visual concept film">
          <span class="film-play-circle">▶</span>
        </div>
        <div class="film-frame-bottom">
          <span>ROEL / VISUAL STUDY</span>
          <span>{homeVideo.source_type === 'youtube' ? 'YOUTUBE &nbsp; · &nbsp; STREAMING' : '00:08 &nbsp; · &nbsp; CONCEPT PREVIEW'}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band">
    <div class="container cta-row gsap-fade-up">
      <div>
        <span class="eyebrow">The next chapter starts here</span>
        <h2>Let's shape your<br /><em class="italic">next space.</em></h2>
      </div>
      <div>
        <p>Tell us what you are creating. We will help you explore the material direction for your home or project.</p>
        <button class="btn" type="button" data-enquiry="Consultation for a new space">Start a conversation <span class="arrow">↗</span></button>
      </div>
    </div>
  </section>
</Layout>
