---
import Layout from '../../layouts/Layout.astro';
import { services, imgSrc } from '../../data/originalData.js';
---

<Layout 
  title="Our Services | ROEL Home Solutions"
  description="Care in every detail. The best outcomes come from the right conversations, decisions and materials at the right time."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Our practice</span>
      <h1>Care in <em>every detail.</em></h1>
      <p>The best outcomes come from the right conversations, decisions and materials at the right time.</p>
      <div class="page-count">03</div>
    </div>
  </section>

  <section class="service-page-list">
    <div class="container">
      {services.map((s) => (
        <article class="service-feature">
          <img src={imgSrc(s.image)} alt={`${s.name} service illustration`} loading="lazy" />
          <div>
            <span class="eyebrow">{s.number} / {s.tag}</span>
            <h2>{s.name}</h2>
            <p>{s.description}</p>
            <a class="text-link" href={`/service/${s.id}`}>Explore this service <span class="arrow">↗</span></a>
          </div>
        </article>
      ))}
      <p class="sample-caption">Service descriptions are proposed website copy to be confirmed with the ROEL team before publication.</p>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-row">
      <div>
        <span class="eyebrow">The next chapter starts here</span>
        <h2>Let's shape your<br /><em class="italic">next space.</em></h2>
      </div>
      <div>
        <p>Tell us what you are creating. We will help you explore the material direction for your home or project.</p>
        <button class="btn" type="button" data-enquiry="Consultation for a new space">Start a conversation <span class="arrow">↗</span></button>
      </div>
    </div>
  </section>
</Layout>
