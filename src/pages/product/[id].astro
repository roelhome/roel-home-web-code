---
import Layout from '../../layouts/Layout.astro';
import { products, imgSrc, waUrl } from '../../data/originalData.js';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product, allProducts: products },
  }));
}

const { product, allProducts } = Astro.props;
const otherProducts = allProducts.filter((p) => p.id !== product.id);

const whatsappLink = waUrl(`Hello ROEL Home Solutions, I would like to enquire about ${product.name} (${product.sku}). Please share details and a quotation.`);

// Product schema for rich search results
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "image": new URL(imgSrc(product.image), "https://roelhomes.com").toString(),
  "description": product.description,
  "sku": product.sku,
  "brand": {
    "@type": "Brand",
    "name": "ROEL Home Solutions"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "INR",
    "price": product.price.replace(/[^0-9]/g, '') || "0",
    "availability": "https://schema.org/InStock"
  }
};
---

<Layout 
  title={`${product.name} | ROEL Home Solutions`}
  description={product.short || product.description}
  image={imgSrc(product.image)}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <section class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/catalogue">Products</a> / <span>{product.name}</span>
    </nav>

    <div class="detail-grid">
      <div class="detail-image">
        <img src={imgSrc(product.image)} alt={`${product.name} sample product image`} />
        <span class="label">{product.category}</span>
      </div>
      <div class="detail-body">
        <div class="eyebrow">{product.sku} / MATERIAL STUDY</div>
        <h1>{product.name}</h1>
        <p>{product.description}</p>
        <div class="detail-price">
          <small>Illustrative starting price</small>
          {product.price}
        </div>
        <div class="micro muted">Sample estimate · final quote depends on finish, dimensions and specification.</div>
        <div class="detail-actions">
          <a class="btn" href={whatsappLink} target="_blank" rel="noopener noreferrer">
            Enquire on WhatsApp <span class="arrow">↗</span>
          </a>
          <button class="btn outline" type="button" data-enquiry={`${product.name} — ${product.sku}`}>
            Request details <span class="arrow">↗</span>
          </button>
        </div>
        <div class="detail-specs">
          <h3>At a glance</h3>
          {product.specs.map((s, i) => (
            <div class="spec-line">
              <span>0{i + 1}</span>
              <span>{s}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="statement-panel">
      <h2>Thoughtful by<br /><em class="italic">design.</em></h2>
      <div>
        <span class="micro">Suggested applications</span>
        <p style="margin-top:16px">{product.applications}</p>
        <p style="margin-top:12px;font-size:11px">Technical details shown are sample content for website design and not a final product data sheet.</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="container">
      <h2 class="related-heading">Explore another <em class="italic">material.</em></h2>
      <div class="product-grid">
        {otherProducts.map((p) => (
          <article class="product-card">
            <a class="product-image" href={`/product/${p.id}`} aria-label={`View ${p.name}`}>
              <img src={imgSrc(p.image)} alt={`${p.name} architectural material sample`} loading="lazy" />
              <span class="on-image-tag">{p.category}</span>
              <span class="image-arrow">↗</span>
            </a>
            <div class="product-info">
              <div>
                <div class="micro muted">{p.sku}</div>
                <h3><a href={`/product/${p.id}`}>{p.name}</a></h3>
                <p>{p.short}</p>
              </div>
              <div class="product-price">
                <small>Sample price from</small>
                {p.price}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-row">
      <div>
        <span class="eyebrow">The next chapter starts here</span>
        <h2>Let's shape your<br /><em class="italic">next space.</em></h2>
      </div>
      <div>
        <p>Tell us what you are creating. We will help you explore the material direction for your home or project.</p>
        <button class="btn" type="button" data-enquiry={`Consultation for ${product.name}`}>Start a conversation <span class="arrow">↗</span></button>
      </div>
    </div>
  </section>
</Layout>
