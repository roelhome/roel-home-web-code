---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getProductById, getProducts } from '../../lib/supabase';
import { imgSrc, waUrl } from '../../data/originalData.js';

const { id } = Astro.params;
const product = id ? await getProductById(id) : undefined;

if (!product) {
  return Astro.redirect('/catalogue');
}

const allProducts = await getProducts();
const otherProducts = allProducts.filter((p) => p.id !== product.id);

// High-resolution architectural gallery images per product
const productGalleries: Record<string, { src: string; alt: string }[]> = {
  'walnut-fluted-wall-panel': [
    { src: '/images/slat.webp', alt: 'Walnut Fluted Wall Panel - Detail Slat Texture' },
    { src: '/images/hero-walls.jpg', alt: 'Walnut Fluted Wall Panel - Architectural Interior Space' },
    { src: '/images/living.webp', alt: 'Walnut Fluted Wall Panel - Living Room Installation' },
  ],
  'signature-oak-door': [
    { src: '/images/door.webp', alt: 'Signature Oak Door - Front Flush Perspective' },
    { src: '/images/projectdoor.webp', alt: 'Signature Oak Door - Frame & Architectural Setting' },
    { src: '/images/hero-doors.jpg', alt: 'Signature Oak Door - Illuminated Entrance System' },
  ],
  'botanical-cnc-screen': [
    { src: '/images/screen.webp', alt: 'Botanical CNC Screen - Laser-Cut Pattern Detail' },
    { src: '/images/divider.webp', alt: 'Botanical CNC Screen - Light Filtering Partition Setting' },
    { src: '/images/wave.webp', alt: 'Botanical CNC Screen - Sculptural Light & Shadow' },
  ],
};

// Normalized Option Dimensions (supports both multi-dimensional options and single-attribute variants)
interface OptionDimensionView {
  name: string;
  values: { name: string; color?: string }[];
}

let dimensions: OptionDimensionView[] = [];

if (product.options && Array.isArray(product.options) && product.options.length > 0) {
  dimensions = product.options.filter((o) => o.values && o.values.length > 0);
} else if (product.variants && Array.isArray(product.variants) && product.variants.length > 0) {
  const dimsMap = new Map<string, { name: string; color?: string }[]>();
  product.variants.forEach((v) => {
    if (v.options && Object.keys(v.options).length > 0) {
      Object.entries(v.options).forEach(([dimName, valName]) => {
        if (!dimsMap.has(dimName)) dimsMap.set(dimName, []);
        if (!dimsMap.get(dimName)!.some((item) => item.name === valName)) {
          dimsMap.get(dimName)!.push({ name: valName, color: v.color });
        }
      });
    } else {
      const dimName = v.attribute_type?.trim() || 'Specification';
      if (!dimsMap.has(dimName)) dimsMap.set(dimName, []);
      if (!dimsMap.get(dimName)!.some((item) => item.name === v.name)) {
        dimsMap.get(dimName)!.push({ name: v.name, color: v.color });
      }
    }
  });

  dimensions = Array.from(dimsMap.entries()).map(([name, values]) => ({ name, values }));
}

const allVariants = product.variants && Array.isArray(product.variants) ? product.variants : [];
const initialVariant = allVariants.find((v) => v.is_available !== false) || allVariants[0] || null;
const initialVariantImages = initialVariant?.images && initialVariant.images.length > 0 ? initialVariant.images : null;

const initialGallery: { src: string; alt: string }[] = initialVariantImages
  ? initialVariantImages.map((src: string, idx: number) => ({
      src: imgSrc(src),
      alt: `${product.name} - ${initialVariant?.name} finish ${idx + 1}`
    }))
  : (product.gallery && product.gallery.length > 0)
  ? product.gallery.map((src: string, idx: number) => ({
      src: imgSrc(src),
      alt: `${product.name} gallery image ${idx + 1}`
    }))
  : productGalleries[product.id] || [
      { src: imgSrc(product.image), alt: `${product.name} architectural material sample` }
    ];

const initialPrice = initialVariant?.price || product.price;
const initialSku = initialVariant?.sku || product.sku;

function formatPriceDisplay(priceStr: string | undefined): string {
  if (!priceStr) return 'Specification On Request';
  const trimmed = priceStr.trim();
  if (trimmed.startsWith('₹') || trimmed.startsWith('$')) return trimmed;
  const num = Number(trimmed.replace(/[^0-9.]/g, ''));
  if (!isNaN(num) && num > 0) {
    const formatted = num.toLocaleString('en-IN');
    const suffix = trimmed.replace(/[0-9.,₹$\s]/g, '');
    return suffix ? `₹${formatted} ${suffix}` : `₹${formatted}`;
  }
  return trimmed;
}

const formattedInitialPrice = formatPriceDisplay(initialPrice);

// Build initial selected options map for each dimension
const initialSelectedOptions: Record<string, string> = {};
if (initialVariant?.options && Object.keys(initialVariant.options).length > 0) {
  Object.assign(initialSelectedOptions, initialVariant.options);
} else {
  dimensions.forEach((dim) => {
    if (dim.values.length > 0) {
      initialSelectedOptions[dim.name] = dim.values[0].name;
    }
  });
}

const whatsappLink = waUrl(`Hello ROEL Home Solutions, I would like to enquire about ${product.name} (${initialSku}) starting from ${formattedInitialPrice}. Please share finish details, dimension options and a quotation.`);

// Product schema for rich search results
const productSchema = {
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": product.name,
  "image": new URL(imgSrc(product.image), "https://roelhomes.com").toString(),
  "description": product.description,
  "sku": product.sku,
  "brand": {
    "@type": "Brand",
    "name": "ROEL Home Solutions"
  },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "INR",
    "price": product.price ? product.price.replace(/[^0-9]/g, '') || "0" : "0",
    "availability": "https://schema.org/InStock"
  }
};
---

<Layout 
  title={`${product.name} | ROEL Home Solutions`}
  description={product.short || product.description}
  image={imgSrc(product.image)}
  bodyClass="is-pdp"
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <section class="container pdp-section">
    <!-- Breadcrumbs -->
    <nav class="breadcrumbs pdp-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep">/</span>
      <a href="/catalogue">Catalogue</a>
      <span class="sep">/</span>
      <span class="active">{product.name}</span>
    </nav>

    <!-- Main 2-Column E-Commerce PDP Grid -->
    <div class="detail-grid pdp-grid">
      <!-- Left Column: Visual Gallery Showcase -->
      <div class="pdp-media-column">
        <div class="detail-image pdp-main-image-wrap">
          <img 
            id="pdp-main-img" 
            src={initialGallery[0].src} 
            alt={initialGallery[0].alt} 
            loading="eager" 
          />
          <span class="label pdp-category-pill">{product.category}</span>
          <span class="pdp-zoom-cue">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
            ARCHITECTURAL FINISH
          </span>
        </div>

        <!-- Thumbnail Selector -->
        <div class="pdp-thumbnails" id="pdp-thumbs-container" role="tablist" aria-label="Product viewpoints">
          {initialGallery.map((g, idx) => (
            <button 
              type="button" 
              class={`pdp-thumb-btn ${idx === 0 ? 'active' : ''}`}
              data-img-src={g.src}
              data-img-alt={g.alt}
              aria-label={`View photo ${idx + 1}`}
            >
              <img src={g.src} alt={g.alt} loading="lazy" />
            </button>
          ))}
        </div>
      </div>

      <!-- Right Column: Sticky Commercial & Enquiry Panel -->
      <div class="pdp-summary-column">
        <div class="pdp-meta-row">
          <span class="pdp-sku-badge" id="pdp-sku-display">{initialSku}</span>
          <span class="pdp-stock-badge">Specification On Request</span>
        </div>

        <h1 class="pdp-product-title">{product.name}</h1>
        <p class="pdp-product-desc">{product.description}</p>

        <!-- Interactive Architectural Option Selectors (The Architectural Minimalist) -->
        {dimensions.length > 0 && (
          <div class="pdp-options-container">
            {dimensions.map((dim) => {
              const activeValue = initialSelectedOptions[dim.name] || dim.values[0]?.name || '';
              const isColorDim = dim.name.toLowerCase().includes('color') || 
                                 dim.name.toLowerCase().includes('finish') || 
                                 dim.values.some((v) => !!v.color || v.name.startsWith('#'));

              return (
                <div class="pdp-option-group" data-dim-box={dim.name}>
                  <div class="pdp-option-header">
                    <span class="pdp-option-title">{dim.name}</span>
                    <span class="pdp-option-divider">—</span>
                    <span class="pdp-option-selected" data-dim-active-label={dim.name}>
                      {activeValue}
                    </span>
                  </div>

                  {isColorDim ? (
                    <div class="pdp-swatches-grid" role="radiogroup" aria-label={`Choose ${dim.name}`}>
                      {dim.values.map((val) => {
                        const isActive = val.name === activeValue;
                        const swatchColor = val.color || (val.name.startsWith('#') ? val.name : '#765941');
                        return (
                          <button
                            type="button"
                            class={`pdp-swatch-circle ${isActive ? 'active' : ''}`}
                            data-option-dim={dim.name}
                            data-option-val={val.name}
                            style={`background-color: ${swatchColor};`}
                            title={val.name}
                            aria-label={`Select ${val.name}`}
                          >
                            <span class="sr-only">{val.name}</span>
                          </button>
                        );
                      })}
                    </div>
                  ) : (
                    <div class="pdp-pills-grid" role="radiogroup" aria-label={`Choose ${dim.name}`}>
                      {dim.values.map((val) => {
                        const isActive = val.name === activeValue;
                        return (
                          <button
                            type="button"
                            class={`pdp-arch-pill ${isActive ? 'active' : ''}`}
                            data-option-dim={dim.name}
                            data-option-val={val.name}
                            title={`Select ${val.name}`}
                          >
                            <span>{val.name}</span>
                          </button>
                        );
                      })}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}

        {/* Hidden Matrix Data for Real-Time Combinations Resolver */}
        <div
          id="pdp-matrix-data"
          style="display:none;"
          data-variants={JSON.stringify(allVariants)}
          data-base-price={product.price}
          data-base-sku={product.sku}
          data-product-name={product.name}
          data-initial-selections={JSON.stringify(initialSelectedOptions)}
        />

        <!-- E-Commerce Pricing Card -->
        <div class="pdp-price-card">
          <div class="pdp-price-top">
            <span class="pdp-price-label">ESTIMATED ARCHITECTURAL RATE</span>
            <span class="pdp-price-currency">INR (₹)</span>
          </div>
          <div class="pdp-price-value" id="pdp-price-display">{formattedInitialPrice}</div>
          <p class="pdp-price-disclaimer">
            Rate varies based on dimension schedules, quantity, custom finishes, and site delivery specifications.
          </p>
        </div>

        <!-- Primary E-Commerce Actions -->
        <div class="pdp-actions">
          <a class="btn-whatsapp-pdp" id="pdp-wa-btn" href={whatsappLink} target="_blank" rel="noopener noreferrer">
            <div class="pdp-btn-content">
              <svg viewBox="0 0 16 16" width="20" height="20" class="pdp-wa-svg">
                <path fill="currentColor" d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.929.809 2.062c.099.134 1.39 2.123 3.37 2.978.472.203.84.324 1.127.416.474.152.905.13 1.246.08.38-.058 1.17-.479 1.338-.942.166-.464.166-.86.116-.942-.049-.082-.181-.133-.379-.232"></path>
              </svg>
              <span>WhatsApp Enquiry</span>
            </div>
            <span class="arrow">↗</span>
          </a>

          <button class="btn outline pdp-btn-consult" type="button" data-enquiry={`${product.name} — ${initialSku}`}>
            <span>Request Quote</span>
            <span class="arrow">↗</span>
          </button>
        </div>

        <!-- E-Commerce Trust Badges Grid -->
        <div class="pdp-trust-grid">
          <div class="pdp-trust-item">
            <div class="pdp-trust-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            </div>
            <div>
              <strong>Pan-India Supply</strong>
              <span>Direct delivery to site</span>
            </div>
          </div>
          <div class="pdp-trust-item">
            <div class="pdp-trust-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
            </div>
            <div>
              <strong>Custom Dimensions</strong>
              <span>Tailored to CAD drawing</span>
            </div>
          </div>
          <div class="pdp-trust-item">
            <div class="pdp-trust-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            </div>
            <div>
              <strong>Tested Durability</strong>
              <span>Premium architectural grade</span>
            </div>
          </div>
          <div class="pdp-trust-item">
            <div class="pdp-trust-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <div>
              <strong>Material Guidance</strong>
              <span>Fast WhatsApp consultation</span>
            </div>
          </div>
        </div>

        <!-- Structured Specifications Grid -->
        <div class="pdp-specs-card">
          <div class="pdp-specs-header">
            <h3>Material Specifications</h3>
            <span class="micro muted">At a glance</span>
          </div>
          <div class="pdp-specs-grid">
            {product.specs.map((s, i) => (
              <div class="pdp-spec-chip">
                <span class="pdp-spec-num">0{i + 1}</span>
                <span class="pdp-spec-val">{s}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Suggested Applications Statement Panel -->
    <div class="statement-panel">
      <h2>Thoughtful by<br /><em class="italic">design.</em></h2>
      <div>
        <span class="micro">Suggested architectural applications</span>
        <p style="margin-top:16px">{product.applications}</p>
        <p style="margin-top:12px;font-size:11px;color:rgba(118,89,65,0.85)">
          Technical details shown are architectural guidelines. Official shop drawings, finish swatches and hardware details are confirmed during project consultation.
        </p>
      </div>
    </div>
  </section>

  <!-- Related Materials -->
  <section class="section" style="padding-top:0">
    <div class="container">
      <h2 class="related-heading">Explore another <em class="italic">material.</em></h2>
      <div class="product-grid">
        {otherProducts.slice(0, 3).map((p) => {
          const waMessage = `Hello ROEL Home Solutions, I would like to enquire about ${p.name} (${p.sku}). Please share details and a quotation.`;
          const waLink = `https://wa.me/918111899991?text=${encodeURIComponent(waMessage)}`;

          return (
            <article class="product-card">
              <a class="product-image" href={`/product/${p.id}`} aria-label={`View ${p.name}`}>
                <img src={imgSrc(p.image)} alt={`${p.name} architectural material sample`} loading="lazy" />
                <span class="on-image-tag">{p.category}</span>
              </a>
              <div class="product-info">
                <div>
                  <div class="micro muted">{p.sku}</div>
                  <h3><a href={`/product/${p.id}`}>{p.name}</a></h3>
                  {p.short && <p>{p.short}</p>}
                </div>
                <div class="product-price">
                  <small>Sample price from</small>
                  <span>{formatPriceDisplay(p.price)}</span>
                </div>
              </div>
              <div class="product-actions">
                <a
                  href={`/product/${p.id}`}
                  class="product-btn-view"
                  aria-label={`View details of ${p.name}`}
                >
                  <span>View Details</span>
                  <span class="product-btn-arrow" aria-hidden="true">→</span>
                </a>
                <span class="product-actions-divider" aria-hidden="true" />
                <a
                  href={waLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="product-btn-enquire"
                  aria-label={`Enquire about ${p.name} on WhatsApp`}
                >
                  <svg
                    viewBox="0 0 16 16"
                    class="product-wa-icon"
                    aria-hidden="true"
                  >
                    <path
                      fill="currentColor"
                      d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.929.809 2.062c.099.134 1.39 2.123 3.37 2.978.472.203.84.324 1.127.416.474.152.905.13 1.246.08.38-.058 1.17-.479 1.338-.942.166-.464.166-.86.116-.942-.049-.082-.181-.133-.379-.232"
                    />
                  </svg>
                  <span>Enquire</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band">
    <div class="container cta-row">
      <div>
        <span class="eyebrow">The next chapter starts here</span>
        <h2>Let's shape your<br /><em class="italic">next space.</em></h2>
      </div>
      <div>
        <p>Tell us what you are creating. We will help you explore the material direction for your home or project.</p>
        <button class="btn" type="button" data-enquiry={`Consultation for ${product.name}`}>Start a conversation <span class="arrow">↗</span></button>
      </div>
    </div>
  </section>

  <!-- Mobile Bottom Sticky Quick Action Bar -->
  <div class="pdp-mobile-sticky-bar" id="pdp-mobile-bar" aria-label="Quick product enquiry">
    <div class="pdp-bar-info">
      <div class="pdp-bar-name">{product.name}</div>
      <div class="pdp-bar-price" id="pdp-bar-price">{formattedInitialPrice}</div>
    </div>
    <a class="pdp-bar-btn" id="pdp-bar-btn" href={whatsappLink} target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 16 16" width="16" height="16">
        <path fill="currentColor" d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.929.809 2.062c.099.134 1.39 2.123 3.37 2.978.472.203.84.324 1.127.416.474.152.905.13 1.246.08.38-.058 1.17-.479 1.338-.942.166-.464.166-.86.116-.942-.049-.082-.181-.133-.379-.232"></path>
      </svg>
      <span>WhatsApp Enquiry</span>
    </a>
  </div>

  <!-- Client Script for Interactive Variant Selection & Gallery Switching -->
  <script is:inline define:vars={{ productName: product.name }}>
    function resolveImgSrc(key) {
      if (!key) return '/images/slat.webp';
      if (key.startsWith('/') || key.startsWith('http') || key.startsWith('data:')) return key;
      return '/images/' + key + '.webp';
    }

    function formatPrice(priceVal) {
      if (!priceVal) return 'Specification On Request';
      const trimmed = String(priceVal).trim();
      if (trimmed.startsWith('₹') || trimmed.startsWith('$')) return trimmed;
      const num = Number(trimmed.replace(/[^0-9.]/g, ''));
      if (!isNaN(num) && num > 0) {
        const formatted = num.toLocaleString('en-IN');
        const suffix = trimmed.replace(/[0-9.,₹$\s]/g, '');
        return suffix ? `₹${formatted} ${suffix}` : `₹${formatted}`;
      }
      return trimmed;
    }

    const mainImg = document.getElementById('pdp-main-img');
    const thumbsContainer = document.getElementById('pdp-thumbs-container');
    const skuDisplay = document.getElementById('pdp-sku-display');
    const priceDisplay = document.getElementById('pdp-price-display');
    const barPriceDisplay = document.getElementById('pdp-bar-price');
    const waBtn = document.getElementById('pdp-wa-btn');
    const barWaBtn = document.getElementById('pdp-bar-btn');

    function attachThumbListeners() {
      const thumbBtns = document.querySelectorAll('.pdp-thumb-btn');
      thumbBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const newSrc = btn.getAttribute('data-img-src');
          const newAlt = btn.getAttribute('data-img-alt');
          if (mainImg && newSrc && mainImg.src !== newSrc) {
            mainImg.style.opacity = '0.3';
            mainImg.style.transform = 'scale(0.98)';
            setTimeout(() => {
              mainImg.src = newSrc;
              if (newAlt) mainImg.alt = newAlt;
              mainImg.style.opacity = '1';
              mainImg.style.transform = 'scale(1)';
            }, 140);
            thumbBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
          }
        });
      });
    }

    attachThumbListeners();

    // Multi-Dimensional Combinations Resolver
    const matrixEl = document.getElementById('pdp-matrix-data');
    let variantsMatrix = [];
    let currentSelections = {};

    if (matrixEl) {
      try {
        variantsMatrix = JSON.parse(matrixEl.getAttribute('data-variants') || '[]');
        currentSelections = JSON.parse(matrixEl.getAttribute('data-initial-selections') || '{}');
      } catch (err) {
        console.error('Failed to parse variants matrix:', err);
      }
    }

    // Query both architectural pills and circular swatches
    const optionButtons = document.querySelectorAll('button[data-option-dim]');

    optionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dim = btn.getAttribute('data-option-dim') || '';
        const val = btn.getAttribute('data-option-val') || '';

        // 1. Update selection state for this dimension
        currentSelections[dim] = val;

        // 2. Highlight clicked button in its dimension group
        document.querySelectorAll(`button[data-option-dim="${dim}"]`).forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        // 3. Update active label in header
        const activeLabel = document.querySelector(`[data-dim-active-label="${dim}"]`);
        if (activeLabel) activeLabel.textContent = val;

        // 4. Resolve matching variant combination from matrix
        const matchedVariant = variantsMatrix.find((v) => {
          if (v.options && Object.keys(v.options).length > 0) {
            return Object.entries(currentSelections).every(([k, expectedVal]) => v.options[k] === expectedVal);
          }
          // Fallback matching by name
          return Object.values(currentSelections).every((expectedVal) => (v.name || '').includes(expectedVal));
        });

        const combinedSummary = Object.values(currentSelections).join(' / ') || val;
        const rawPrice = matchedVariant?.price || (matrixEl ? matrixEl.getAttribute('data-base-price') : '') || '';
        const activeSku = matchedVariant?.sku || (matrixEl ? matrixEl.getAttribute('data-base-sku') : '') || '';
        const isAvail = matchedVariant ? (matchedVariant.is_available !== false) : true;

        const formattedPrice = formatPrice(rawPrice);

        // 5. Update price display
        if (priceDisplay) {
          priceDisplay.textContent = isAvail ? formattedPrice : 'Out of Specification';
        }
        if (barPriceDisplay) {
          barPriceDisplay.textContent = isAvail ? formattedPrice : 'Unavailable';
        }
        if (skuDisplay && activeSku) {
          skuDisplay.textContent = activeSku;
        }

        // 6. Update WhatsApp Enquiry Links
        const waText = isAvail
          ? `Hello ROEL Home Solutions, I would like to enquire about ${productName} — ${combinedSummary} (${activeSku}) priced at ${formattedPrice}. Please share details and dimension options.`
          : `Hello ROEL Home Solutions, I would like to check custom availability for ${productName} — ${combinedSummary} (${activeSku}).`;
        const waUrl = 'https://wa.me/918111899991?text=' + encodeURIComponent(waText);
        if (waBtn) waBtn.setAttribute('href', waUrl);
        if (barWaBtn) barWaBtn.setAttribute('href', waUrl);

        // Update consultation button
        const quoteBtn = document.querySelector('.pdp-btn-consult');
        if (quoteBtn) {
          quoteBtn.setAttribute('data-enquiry', `${productName} — ${combinedSummary} (${activeSku}) - ${formattedPrice}`);
        }

        // 7. Update Images & Thumbs if matched variant has dedicated photos
        if (matchedVariant?.images && Array.isArray(matchedVariant.images) && matchedVariant.images.length > 0) {
          const firstImg = resolveImgSrc(matchedVariant.images[0]);
          if (mainImg) {
            mainImg.style.opacity = '0.3';
            setTimeout(() => {
              mainImg.src = firstImg;
              mainImg.alt = `${productName} - ${combinedSummary}`;
              mainImg.style.opacity = '1';
            }, 140);
          }

          if (thumbsContainer) {
            thumbsContainer.innerHTML = '';
            matchedVariant.images.forEach((imgKey, idx) => {
              const resolved = resolveImgSrc(imgKey);
              const b = document.createElement('button');
              b.type = 'button';
              b.className = `pdp-thumb-btn ${idx === 0 ? 'active' : ''}`;
              b.setAttribute('data-img-src', resolved);
              b.setAttribute('data-img-alt', `${productName} - ${combinedSummary} view ${idx + 1}`);
              b.setAttribute('aria-label', `View photo ${idx + 1}`);
              b.innerHTML = `<img src="${resolved}" alt="${productName} photo ${idx + 1}" loading="lazy" />`;
              thumbsContainer.appendChild(b);
            });
            attachThumbListeners();
          }
        }
      });
    });

    // Mobile Sticky Bar Observer
    const mobileBar = document.getElementById('pdp-mobile-bar');
    const footer = document.querySelector('footer');

    if (mobileBar && footer && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            mobileBar.style.transform = 'translateY(100%)';
            mobileBar.style.opacity = '0';
          } else {
            mobileBar.style.transform = 'translateY(0)';
            mobileBar.style.opacity = '1';
          }
        });
      }, { rootMargin: '0px 0px 80px 0px' });

      observer.observe(footer);
    }
  </script>

  <style>
    .pdp-product-title {
      font-family: RoelSerif, Georgia, serif;
      font-weight: 400;
      font-size: clamp(34px, 3.6vw, 48px);
      line-height: 1.08;
      letter-spacing: -0.025em;
      color: var(--ink);
      margin: 0 0 16px;
    }

    /* ==========================================================================
       OPTION 1: THE ARCHITECTURAL MINIMALIST (Clean, Uncluttered, Luxury)
       ========================================================================== */
    .pdp-options-container {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin-bottom: 24px;
    }

    .pdp-option-group {
      padding-bottom: 16px;
      border-bottom: 1px solid rgba(118, 89, 65, 0.14);
    }

    .pdp-option-group:last-child {
      border-bottom: none;
      padding-bottom: 4px;
    }

    .pdp-option-header {
      display: flex;
      align-items: baseline;
      gap: 8px;
      margin-bottom: 10px;
      font-size: 11.5px;
      line-height: 1.4;
    }

    .pdp-option-title {
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--walnut, #765941);
      font-size: 11px;
    }

    .pdp-option-divider {
      color: rgba(118, 89, 65, 0.35);
      font-size: 11px;
    }

    .pdp-option-selected {
      font-weight: 600;
      color: var(--ink, #19120C);
      letter-spacing: 0.015em;
    }

    /* Architectural Material / Size Pills */
    .pdp-pills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .pdp-arch-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 8px 16px;
      font-family: inherit;
      font-size: 12.5px;
      font-weight: 500;
      letter-spacing: 0.01em;
      color: var(--ink, #19120C);
      background-color: #FAF7F2;
      border: 1px solid rgba(118, 89, 65, 0.26);
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
      user-select: none;
    }

    .pdp-arch-pill:hover {
      background-color: #F2EAE0;
      border-color: var(--walnut, #765941);
      transform: translateY(-1px);
    }

    .pdp-arch-pill.active {
      background-color: var(--ink, #19120C);
      border-color: var(--ink, #19120C);
      color: var(--ivory, #F0E2CE);
      box-shadow: 0 2px 8px rgba(25, 18, 12, 0.22);
      transform: translateY(0);
      font-weight: 600;
    }

    /* Pure Circular Color Swatch Discs */
    .pdp-swatches-grid {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      padding: 4px 2px;
    }

    .pdp-swatch-circle {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid #FFFFFF;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
      cursor: pointer;
      position: relative;
      padding: 0;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      outline: none;
      flex-shrink: 0;
    }

    .pdp-swatch-circle:hover {
      transform: scale(1.1);
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.2);
    }

    /* Concentric Apple-Style Double Ring when Active */
    .pdp-swatch-circle.active {
      box-shadow: 0 0 0 2.5px #FFFFFF, 0 0 0 4.5px var(--ink, #19120C);
      transform: scale(1.05);
    }

    .pdp-swatch-circle:focus-visible {
      outline: 2px solid var(--walnut, #765941);
      outline-offset: 4px;
    }

    /* Accessible Screen Reader Utility */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }

    @media (max-width: 768px) {
      /* Remove thumbnail row on mobile to save vertical space so variant updates are visible */
      .pdp-thumbnails {
        display: none !important;
      }

      .pdp-main-image-wrap {
        height: clamp(260px, 40vh, 320px) !important;
      }

      .pdp-grid {
        gap: 16px !important;
        padding-bottom: 35px !important;
      }

      .pdp-product-title {
        font-size: clamp(32px, 8vw, 42px) !important;
        line-height: 1.1 !important;
        margin: 8px 0 12px !important;
      }

      .pdp-product-desc {
        font-size: 12.5px !important;
        line-height: 1.65 !important;
        margin: 0 0 16px !important;
      }
    }
  </style>
</Layout>
