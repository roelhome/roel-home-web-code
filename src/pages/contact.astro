---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import { waUrl } from '../data/originalData.js';

const whatsappChatUrl = waUrl('Hello ROEL Home Solutions, I would like to know more about your products and services.');
---

<Layout 
  title="Connect With Us | ROEL Home Solutions"
  description="Whether you are creating a home, working on a project or exploring a product, we would love to hear from you."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Connect with us</span>
      <h1>Let's talk <em>materials.</em></h1>
      <p>Whether you are creating a home, working on a project or exploring a product, we would love to hear from you.</p>
    </div>
  </section>

  <section class="container contact-grid">
    <div class="contact-info">
      <span class="eyebrow">ROEL / Kochi, Kerala</span>
      <h2>Start with a <em class="italic">conversation.</em></h2>
      <p>Share your ideas, dimensions or references. Our team can help you take the next step towards the right architectural solution.</p>
      
      <div class="contact-block">
        <span class="micro">Call us</span>
        <a href="tel:+918111899991">+91 81118 99991</a>
        <a href="tel:+918111899188">+91 81118 99188</a>
      </div>

      <div class="contact-block">
        <span class="micro">Visit us</span>
        <span class="address">
          NH-66, Valluvally-Kochal,<br />
          Koonammavu, Kochi,<br />
          Kerala 683518
        </span>
        <a 
          style="font:700 11px RoelSans, sans-serif;margin-top:18px;display:inline-block;text-decoration:underline" 
          target="_blank" 
          rel="noopener noreferrer" 
          href="https://www.google.com/maps/search/?api=1&query=NH-66%2C+Valluvally-Kochal%2C+Koonammavu%2C+Kochi%2C+Kerala+683518"
        >
          Open in Google Maps ↗
        </a>
      </div>

      <div class="contact-block">
        <span class="micro">Send a quick message</span>
        <a 
          style="font:400 24px RoelSerif, serif;margin-top:15px" 
          href={whatsappChatUrl} 
          target="_blank" 
          rel="noopener noreferrer"
        >
          Chat on WhatsApp ↗
        </a>
      </div>
    </div>

    <div class="form-panel">
      <span class="eyebrow">An enquiry begins here</span>
      <h3>Tell us what you<br />have in mind.</h3>
      <ContactForm client:load />
    </div>
  </section>
</Layout>
