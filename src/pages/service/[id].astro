---
import Layout from '../../layouts/Layout.astro';
import { services, imgSrc, waUrl } from '../../data/originalData.js';

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { id: service.id },
    props: { service, allServices: services },
  }));
}

const { service } = Astro.props;

const whatsappLink = waUrl(`Hello ROEL, I am interested in your ${service.name} service. Please contact me to discuss my requirement.`);
const stepTitles = ['Understand', 'Explore', 'Refine', 'Plan'];
---

<Layout 
  title={`${service.name} | ROEL Home Solutions`}
  description={service.summary || service.description}
  image={imgSrc(service.image)}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/services">Services</a> / <span>{service.name}</span>
    </nav>
  </div>

  <section class="service-detail-hero">
    <div class="copy">
      <span class="eyebrow" style="color:var(--champagne)">Service / {service.number}</span>
      <h1>{service.name}</h1>
      <p>{service.description}</p>
      <div style="margin-top:30px">
        <a class="btn gold" href={whatsappLink} target="_blank" rel="noopener noreferrer">
          Discuss on WhatsApp <span class="arrow">↗</span>
        </a>
      </div>
    </div>
    <img src={imgSrc(service.image)} alt={`${service.name} architectural service`} />
  </section>

  <section class="container service-detail-features">
    <div>
      <span class="eyebrow">A considered process</span>
      <h2>How we can <em class="italic">help.</em></h2>
      <p style="line-height:1.9;color:var(--muted);font-size:13px;max-width:370px">
        Every space has its own practical needs, personality and ambitions. These are illustrative steps for a tailored conversation with our team.
      </p>
      <button class="btn outline" type="button" data-enquiry={`${service.name} service enquiry`}>
        Request a discussion <span class="arrow">↗</span>
      </button>
    </div>
    <div>
      {service.items.map((x, i) => (
        <div class="step">
          <strong>0{i + 1}</strong>
          <div>
            <h3>{stepTitles[i] || `Step 0${i + 1}`}</h3>
            <p>{x}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-row">
      <div>
        <span class="eyebrow">The next chapter starts here</span>
        <h2>Let's shape your<br /><em class="italic">next space.</em></h2>
      </div>
      <div>
        <p>Tell us what you are creating. We will help you explore the material direction for your home or project.</p>
        <button class="btn" type="button" data-enquiry={`Consultation for ${service.name}`}>Start a conversation <span class="arrow">↗</span></button>
      </div>
    </div>
  </section>
</Layout>
