---
import Layout from '../../layouts/Layout.astro';
import CatalogueFilter from '../../components/CatalogueFilter';
import { getProducts, getCategories } from '../../lib/supabase';

export const prerender = false;

const products = await getProducts();
const categories = await getCategories();
---

<Layout 
  title="Our Products | ROEL Home Solutions"
  description="A considered range of architectural surfaces, doors and decorative features for contemporary spaces."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">The ROEL edit</span>
      <h1>Our <em>products.</em></h1>
      <p>A considered range of architectural surfaces, doors and decorative features for contemporary spaces.</p>
      <div class="page-count">{String(products.length).padStart(2, '0')}</div>
    </div>
  </section>

  <section class="catalogue-section">
    <CatalogueFilter client:load initialProducts={products} initialCategories={categories} />
  </section>

  <section class="cta-band">
    <div class="container cta-row">
      <div>
        <span class="eyebrow">The next chapter starts here</span>
        <h2>Let's shape your<br /><em class="italic">next space.</em></h2>
      </div>
      <div>
        <p>Tell us what you are creating. We will help you explore the material direction for your home or project.</p>
        <button class="btn" type="button" data-enquiry="Consultation for a new space">Start a conversation <span class="arrow">↗</span></button>
      </div>
    </div>
  </section>
</Layout>
