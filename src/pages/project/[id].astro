---
import Layout from '../../layouts/Layout.astro';
import { projects, imgSrc, waUrl } from '../../data/originalData.js';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project, allProjects: projects },
  }));
}

const { project } = Astro.props;

const whatsappLink = waUrl(`Hello ROEL, I viewed ${project.name} on your website and would like to discuss a similar design direction.`);
---

<Layout 
  title={`${project.name} | ROEL Home Solutions`}
  description={project.summary || project.story}
  image={imgSrc(project.image)}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/projects">Projects</a> / <span>{project.name}</span>
    </nav>
  </div>

  <section class="container project-detail-header">
    <span class="eyebrow">{project.isDemo ? 'Illustrative portfolio concept' : 'Project portfolio entry'} / {project.category}</span>
    <h1>{project.name}</h1>
    <div class="project-meta-line">
      <div><small>Location</small><span>{project.location}</span></div>
      <div><small>Project type</small><span>{project.category}</span></div>
      <div><small>Year</small><span>{project.year}</span></div>
      <div><small>Portfolio status</small><span>{project.isDemo ? 'Design sample' : 'Portfolio entry'}</span></div>
    </div>
  </section>

  <div class="container project-detail-photo">
    <img src={imgSrc(project.image)} alt={`${project.name} project showcase`} />
  </div>

  <section class="container project-story">
    <div>
      <span class="eyebrow">A closer look</span>
      <h2>The space<br /><em class="italic">in focus.</em></h2>
    </div>
    <div>
      <p>{project.story || project.summary}</p>
      <p>{project.summary}</p>
      <p style="font-size:11px">{project.isDemo ? 'This is a sample portfolio narrative created for website design.' : 'This entry was added to the ROEL portfolio.'}</p>
      <a class="btn outline" href={whatsappLink} target="_blank" rel="noopener noreferrer">
        Discuss a similar space <span class="arrow">↗</span>
      </a>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-row">
      <div>
        <span class="eyebrow">The next chapter starts here</span>
        <h2>Let's shape your<br /><em class="italic">next space.</em></h2>
      </div>
      <div>
        <p>Tell us what you are creating. We will help you explore the material direction for your home or project.</p>
        <button class="btn" type="button" data-enquiry={`Consultation regarding ${project.name}`}>Start a conversation <span class="arrow">↗</span></button>
      </div>
    </div>
  </section>
</Layout>
